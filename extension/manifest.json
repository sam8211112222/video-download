{
  "manifest_version": 3,
  "name": "VDD Video Downloader",
  "version": "1.4.0",
  "description": "Download the videos, covers and photos you are viewing (Instagram, Threads and more) straight from the page.",
  "permissions": ["downloads", "cookies", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["resolve.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "download-visible": {
      "suggested_key": { "default": "Alt+Shift+D", "mac": "Alt+Shift+D" },
      "description": "Download the video on screen"
    },
    "download-image": {
      "suggested_key": { "default": "Alt+Shift+I", "mac": "Alt+Shift+I" },
      "description": "Download the photo (or video cover) on screen"
    }
  }
}
